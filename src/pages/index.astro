---
import Layout from '../layouts/Layout.astro';
const title = 'Final grade calculator';
const description = 'Use this final grade calculator to find the exam score you need. Calculate weighted course grades, test averages, assignment categories, and points-based scenarios.';
const faq = [
  {
    question: 'What do I need on my final exam to get the grade I want?',
    answer: 'Enter your current course percentage, target percentage, and the final exam’s share of the overall grade. This final exam grade calculator shows the score you need and whether your target is achievable.',
    mode: 'required',
    linkText: 'Open the final-score calculator',
  },
  {
    question: 'What grade do I need to get an A?',
    answer: 'Enter the percentage cutoff your instructor uses for an A as your desired course grade. Grade cutoffs vary by school and class, so check your syllabus rather than assuming a universal threshold.',
  },
  {
    question: 'What happens if I need more than 100%?',
    answer: 'The target is impossible with the current weights and a regular exam capped at 100%. The result shows the highest course grade you could earn with a perfect final.',
  },
  {
    question: 'Can I still pass if I fail my final?',
    answer: 'Enter 0% as the final score in Overall after final, or review the 0% scenario in the table. The calculation does not assume a minimum exam score or other course-specific rules.',
  },
  {
    question: 'Does the final exam weight affect my current grade?',
    answer: 'The calculator treats your current grade as the average for coursework outside the final. The final weight determines how much that average and the exam score each contribute to the course grade.',
  },
  {
    question: 'How does a weighted grade calculator work?',
    answer: 'Each category or exam contributes according to its share of the total course grade. For a grade calculator with weights, enter the final exam weight or use Advanced mode for weighted categories and assignments.',
    mode: 'advanced',
    linkText: 'Open the weighted grade calculator',
  },
  {
    question: 'How do I calculate my overall grade after the final?',
    answer: 'Choose Overall after final, then enter your current course percentage, final exam score, and final exam course weight. This overall grade calculator combines the two weighted contributions.',
    mode: 'overall',
    linkText: 'Open the overall grade calculator',
  },
  {
    question: 'Can I use this calculator for college or high school?',
    answer: 'Yes. The calculations work for any course that provides a current grade and clear assessment weights. Always follow your instructor’s syllabus for rounding, drops, curves, and other policies.',
  },
  {
    question: 'Can I use this as a semester grade calculator?',
    answer: 'Yes. Use the required-final mode if you know your current semester average and final exam weight, or Advanced mode to enter weighted course categories and assignments. It can work as a college grade calculator or for high school; check your syllabus for the weights and grading rules.',
    mode: 'advanced',
    linkText: 'Open the semester grade calculator',
  },
  {
    question: 'Can I calculate my overall grade from assignment scores?',
    answer: 'Yes. Advanced mode works like an assignment grade calculator: add assignment scores and their relative weights within course categories. Use the points-based mode if your course is graded by total points instead.',
    mode: 'advanced',
    linkText: 'Open the assignment grade calculator',
  },
  {
    question: 'Can I calculate my GPA?',
    answer: 'The calculator does not convert percentages into a universal GPA. You can optionally display a letter grade or GPA by entering the thresholds published by your own institution.',
  },
  {
    question: 'Can I drop my lowest test grade?',
    answer: 'Yes. Choose Tests & drops or Drop lowest, enter every score and relative weight, and set the drop count your course allows. The result identifies the scores excluded from the average.',
  },
  {
    question: 'How does the final grade formula work?',
    answer: 'It subtracts the contribution of your current coursework from your target, then divides the remainder by the final exam’s share of the course grade. Both grades and the exam weight are percentages.',
  },
  {
    question: 'Can I use a grade calculator with points?',
    answer: 'Yes. The points-based grade calculator uses points earned, points possible so far, points available on the final, and your target percentage.',
    mode: 'points',
    linkText: 'Open the points-based grade calculator',
  },
  {
    question: 'Does a final exam grade calculator convert my percentage to a GPA?',
    answer: 'No universal conversion is assumed. Choose letter-grade or GPA display, then enter the thresholds published by your institution. Percentage calculations remain separate from the optional display.',
  },
  {
    question: 'What if the final exam has no weight?',
    answer: 'With a zero-weight final, the final cannot change your course grade. The calculator reports whether your target is already reached or is impossible under that weighting.',
  },
];
---

<Layout title={title} description={description}>
  <header class="site-header">
    <a class="brand" href="/" aria-label="Final grade calculator home">
      <span class="brand-mark" aria-hidden="true">g</span>
      <span class="brand-copy"><strong>Final grade calculator</strong></span>
    </a>
    <nav aria-label="Main navigation">
      <a href="#calculator">Calculator</a>
      <a href="#how-it-works">How it works</a>
      <a href="#faq">FAQs</a>
    </nav>
    <div class="header-tools">
      <div class="theme-control" role="group" aria-label="Color theme">
        <button type="button" class="theme-option" data-theme-option="light" aria-pressed="true">Light</button>
        <button type="button" class="theme-option" data-theme-option="dark" aria-pressed="false">Dark</button>
      </div>
      <span class="header-note"><span class="status-dot"></span> Free · No sign-up</span>
    </div>
  </header>

  <main>
    <section class="hero" aria-labelledby="page-title">
      <h1 id="page-title">Final grade calculator</h1>
    </section>

    <section class="calculator-shell" id="calculator" aria-labelledby="calculator-title">
      <div class="calculator-topline">
        <div>
          <div class="section-kicker">GRADE PLANNER <span class="live-pill"><i></i> LIVE</span></div>
          <h2 id="calculator-title">Final grade calculator</h2>
        </div>
        <button class="text-button reset-button" type="button" id="reset-calculator">
          <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3.3 8a6.8 6.8 0 1 1-.1 3.5M3 3.7V8h4.3" /></svg>
          Reset
        </button>
      </div>

      <div class="mode-tabs" role="tablist" aria-label="Calculator modes">
        <button type="button" role="tab" id="tab-required" aria-controls="panel-required" aria-selected="true" data-mode="required">Need on my final</button>
        <button type="button" role="tab" id="tab-overall" aria-controls="panel-overall" aria-selected="false" data-mode="overall">Overall after final</button>
        <button type="button" role="tab" id="tab-tests" aria-controls="panel-tests" aria-selected="false" data-mode="tests">Tests &amp; drops</button>
        <button type="button" role="tab" id="tab-drops" aria-controls="panel-drops" aria-selected="false" data-mode="drops">Drop lowest</button>
        <button type="button" role="tab" id="tab-components" aria-controls="panel-components" aria-selected="false" data-mode="components">Exam components</button>
        <button type="button" role="tab" id="tab-points" aria-controls="panel-points" aria-selected="false" data-mode="points">Points-based</button>
        <button type="button" role="tab" id="tab-advanced" aria-controls="panel-advanced" aria-selected="false" data-mode="advanced">Advanced</button>
      </div>

      <div class="calculator-body">
        <form id="grade-form" novalidate>
          <section class="mode-panel" id="panel-required" role="tabpanel" aria-labelledby="tab-required" data-panel="required">
            <div class="panel-heading">
              <span class="step-number">01</span>
              <div><h3>Set your course goal</h3><p>Enter your current standing and the grade you’re aiming for.</p></div>
            </div>
            <div class="input-grid">
              <label class="field">
                <span>Current course grade <span class="tip" title="Your grade before the final exam. Use the percentage shown by your instructor." aria-label="Your grade before the final exam. Use the percentage shown by your instructor.">i</span></span>
                <span class="input-wrap"><input name="current" type="number" min="0" max="100" step="any" value="92.4" inputmode="decimal" required /><b>%</b></span>
                <small>Your grade so far</small>
              </label>
              <label class="field">
                <span>Desired course grade <span class="tip" title="Your target for the total course grade after the final." aria-label="Your target for the total course grade after the final.">i</span></span>
                <span class="input-wrap"><input name="target" type="number" min="0" max="100" step="any" value="90" inputmode="decimal" required /><b>%</b></span>
                <small>The overall grade you want</small>
              </label>
              <label class="field">
                <span>Final exam weight <span class="tip" title="The final exam’s share of your total course grade, not its share of your remaining work." aria-label="The final exam’s share of your total course grade, not its share of your remaining work.">i</span></span>
                <span class="input-wrap"><input name="weight" type="number" min="0" max="100" step="any" value="10" inputmode="decimal" required /><b>%</b></span>
                <small>Its share of the course grade</small>
              </label>
            </div>
            <p class="mode-note"><span aria-hidden="true">✦</span> The final is worth 10% of your course grade. Your current 92.4% makes up the other 90%.</p>
          </section>

          <section class="mode-panel" id="panel-overall" role="tabpanel" aria-labelledby="tab-overall" data-panel="overall" hidden>
            <div class="panel-heading"><span class="step-number">02</span><div><h3>Calculate your final course grade</h3><p>See how a final exam score changes your overall percentage.</p></div></div>
            <div class="input-grid">
              <label class="field"><span>Current course grade</span><span class="input-wrap"><input name="overallCurrent" type="number" min="0" max="100" step="any" value="92.4" required /><b>%</b></span></label>
              <label class="field"><span>Final exam score</span><span class="input-wrap"><input name="finalScore" type="number" min="0" max="100" step="any" value="80" required /><b>%</b></span></label>
              <label class="field"><span>Final exam weight</span><span class="input-wrap"><input name="overallWeight" type="number" min="0" max="100" step="any" value="10" required /><b>%</b></span></label>
            </div>
          </section>

          <section class="mode-panel" id="panel-tests" role="tabpanel" aria-labelledby="tab-tests" data-panel="tests" hidden>
            <div class="panel-heading"><span class="step-number">03</span><div><h3>Use your test scores</h3><p>Find the score you need on another test. Optionally drop the lowest score.</p></div></div>
            <div class="input-grid compact-grid">
              <label class="field"><span>Target course grade</span><span class="input-wrap"><input name="testsTarget" type="number" min="0" max="100" step="any" value="90" required /><b>%</b></span></label>
              <label class="field"><span>Final test course weight</span><span class="input-wrap"><input name="testsWeight" type="number" min="0" max="100" step="any" value="20" required /><b>%</b></span></label>
              <label class="field"><span>Drop lowest scores</span><span class="input-wrap"><input name="dropCount" type="number" min="0" max="10" step="1" value="0" required /><b>tests</b></span></label>
              <label class="field"><span>Test average method</span><select name="testWeighting"><option value="weighted">Weighted by test weight</option><option value="unweighted">Unweighted average</option></select></label>
            </div>
            <div class="rows-heading"><span>Your completed tests</span><span>Score · test weight</span></div>
            <div id="test-rows" class="score-rows">
              <div class="score-row"><label><span class="sr-only">Test 1 score</span><input aria-label="Test 1 score" class="test-score" type="number" min="0" max="100" step="any" value="82" required /><b>%</b></label><span class="row-divider">at</span><label><span class="sr-only">Test 1 weight</span><input aria-label="Test 1 weight" class="test-weight" type="number" min="0.01" step="any" value="1" required /><b>×</b></label><button class="icon-button remove-row" type="button" aria-label="Remove test 1">×</button></div>
              <div class="score-row"><label><span class="sr-only">Test 2 score</span><input aria-label="Test 2 score" class="test-score" type="number" min="0" max="100" step="any" value="90" required /><b>%</b></label><span class="row-divider">at</span><label><span class="sr-only">Test 2 weight</span><input aria-label="Test 2 weight" class="test-weight" type="number" min="0.01" step="any" value="1" required /><b>×</b></label><button class="icon-button remove-row" type="button" aria-label="Remove test 2">×</button></div>
              <div class="score-row"><label><span class="sr-only">Test 3 score</span><input aria-label="Test 3 score" class="test-score" type="number" min="0" max="100" step="any" value="96" required /><b>%</b></label><span class="row-divider">at</span><label><span class="sr-only">Test 3 weight</span><input aria-label="Test 3 weight" class="test-weight" type="number" min="0.01" step="any" value="1" required /><b>×</b></label><button class="icon-button remove-row" type="button" aria-label="Remove test 3">×</button></div>
            </div>
            <button type="button" class="add-row-button" id="add-test">＋ Add a score</button>
            <p class="field-hint">Test weights are relative to one another; the final’s weight is a percentage of the whole course grade.</p>
          </section>

          <section class="mode-panel" id="panel-components" role="tabpanel" aria-labelledby="tab-components" data-panel="components" hidden>
            <div class="panel-heading"><span class="step-number">04</span><div><h3>Break down your final</h3><p>Enter the weight of each component within the final. Leave ungraded scores blank.</p></div></div>
            <div class="input-grid compact-grid">
              <label class="field"><span>Current course grade</span><span class="input-wrap"><input name="componentCurrent" type="number" min="0" max="100" step="any" value="92" required /><b>%</b></span></label>
              <label class="field"><span>Target course grade</span><span class="input-wrap"><input name="componentTarget" type="number" min="0" max="100" step="any" value="90" required /><b>%</b></span></label>
              <label class="field"><span>Final exam course weight</span><span class="input-wrap"><input name="componentFinalWeight" type="number" min="0" max="100" step="any" value="20" required /><b>%</b></span></label>
            </div>
            <div class="rows-heading"><span>Final exam components</span><span>Score · final share</span></div>
            <div id="component-rows" class="score-rows">
              <div class="score-row component-row"><label><span class="sr-only">Written exam score</span><input aria-label="Written exam score; leave blank if not graded" class="component-score" type="number" min="0" max="100" step="any" placeholder="—" /><b>%</b></label><span class="row-divider">at</span><label><span class="sr-only">Written exam final share</span><input aria-label="Written exam final share" class="component-weight" type="number" min="0.01" step="any" value="60" required /><b>%</b></label><span class="row-name">Written</span></div>
              <div class="score-row component-row"><label><span class="sr-only">Practical exam score</span><input aria-label="Practical exam score; leave blank if not graded" class="component-score" type="number" min="0" max="100" step="any" placeholder="—" /><b>%</b></label><span class="row-divider">at</span><label><span class="sr-only">Practical exam final share</span><input aria-label="Practical exam final share" class="component-weight" type="number" min="0.01" step="any" value="25" required /><b>%</b></label><span class="row-name">Practical</span></div>
              <div class="score-row component-row"><label><span class="sr-only">Oral exam score</span><input aria-label="Oral exam score; leave blank if not graded" class="component-score" type="number" min="0" max="100" step="any" placeholder="—" /><b>%</b></label><span class="row-divider">at</span><label><span class="sr-only">Oral exam final share</span><input aria-label="Oral exam final share" class="component-weight" type="number" min="0.01" step="any" value="15" required /><b>%</b></label><span class="row-name">Oral</span></div>
            </div>
            <button type="button" class="add-row-button" id="add-component">＋ Add a component</button>
            <p class="field-hint">Component weights must add up to 100% of the final exam.</p>
          </section>

          <section class="mode-panel" id="panel-points" role="tabpanel" aria-labelledby="tab-points" data-panel="points" hidden>
            <div class="panel-heading"><span class="step-number">05</span><div><h3>Calculate by points</h3><p>Use your course’s actual point totals instead of percentage weights.</p></div></div>
            <div class="input-grid">
              <label class="field"><span>Points earned so far</span><span class="input-wrap"><input name="pointsEarned" type="number" min="0" step="any" value="180" required /><b>pts</b></span></label>
              <label class="field"><span>Points possible so far</span><span class="input-wrap"><input name="pointsPossible" type="number" min="0.01" step="any" value="200" required /><b>pts</b></span></label>
              <label class="field"><span>Points available on final</span><span class="input-wrap"><input name="finalPoints" type="number" min="0.01" step="any" value="100" required /><b>pts</b></span></label>
              <label class="field"><span>Desired course grade</span><span class="input-wrap"><input name="pointsTarget" type="number" min="0" max="100" step="any" value="90" required /><b>%</b></span></label>
            </div>
          </section>

          <section class="mode-panel" id="panel-drops" role="tabpanel" aria-labelledby="tab-drops" data-panel="drops" hidden>
            <div class="panel-heading"><span class="step-number">06</span><div><h3>Account for dropped grades</h3><p>Choose how many of your lowest test or homework scores your course drops.</p></div></div>
            <div class="input-grid">
              <label class="field"><span>Category</span><select name="dropCategory"><option>Tests</option><option>Homework</option><option>Quizzes</option><option>Assignments</option></select></label>
              <label class="field"><span>Target course grade</span><span class="input-wrap"><input name="dropsTarget" type="number" min="0" max="100" step="any" value="90" required /><b>%</b></span></label>
              <label class="field"><span>Final exam course weight</span><span class="input-wrap"><input name="dropsWeight" type="number" min="0" max="100" step="any" value="20" required /><b>%</b></span></label>
              <label class="field"><span>Number of lowest scores to drop</span><span class="input-wrap"><input name="dropsCount" type="number" min="0" max="10" step="1" value="1" required /><b>scores</b></span></label>
            </div>
            <div class="rows-heading"><span>Scores in this category</span><span>Score · relative weight</span></div>
            <div id="drop-rows" class="score-rows">
              <div class="score-row"><label><span class="sr-only">Category score 1</span><input aria-label="Category score 1" class="drop-score" type="number" min="0" max="100" step="any" value="62" required /><b>%</b></label><span class="row-divider">at</span><label><span class="sr-only">Category score 1 weight</span><input aria-label="Category score 1 weight" class="drop-weight" type="number" min="0.01" step="any" value="1" required /><b>×</b></label><button class="icon-button remove-row" type="button" aria-label="Remove score 1">×</button></div>
              <div class="score-row"><label><span class="sr-only">Category score 2</span><input aria-label="Category score 2" class="drop-score" type="number" min="0" max="100" step="any" value="88" required /><b>%</b></label><span class="row-divider">at</span><label><span class="sr-only">Category score 2 weight</span><input aria-label="Category score 2 weight" class="drop-weight" type="number" min="0.01" step="any" value="1" required /><b>×</b></label><button class="icon-button remove-row" type="button" aria-label="Remove score 2">×</button></div>
              <div class="score-row"><label><span class="sr-only">Category score 3</span><input aria-label="Category score 3" class="drop-score" type="number" min="0" max="100" step="any" value="94" required /><b>%</b></label><span class="row-divider">at</span><label><span class="sr-only">Category score 3 weight</span><input aria-label="Category score 3 weight" class="drop-weight" type="number" min="0.01" step="any" value="1" required /><b>×</b></label><button class="icon-button remove-row" type="button" aria-label="Remove score 3">×</button></div>
            </div>
            <button type="button" class="add-row-button" id="add-drop-score">＋ Add a score</button>
          </section>

          <section class="mode-panel" id="panel-advanced" role="tabpanel" aria-labelledby="tab-advanced" data-panel="advanced" hidden>
            <div class="panel-heading"><span class="step-number">07</span><div><h3>Build your weighted grade</h3><p>Add course categories and graded work. Category weights are shares of the whole course.</p></div></div>
            <div class="input-grid compact-grid">
              <label class="field"><span>Target course grade</span><span class="input-wrap"><input name="advancedTarget" type="number" min="0" max="100" step="any" value="90" required /><b>%</b></span></label>
              <label class="field"><span>Final / remaining work weight</span><span class="input-wrap"><input name="advancedWeight" type="number" min="0" max="100" step="any" value="30" required /><b>%</b></span><small>Course weight not yet represented by categories</small></label>
              <label class="field"><span>Category calculation</span><select name="categoryWeighting"><option value="weighted">Weighted categories</option><option value="unweighted">Equal category averages</option></select></label>
              <label class="field"><span>Retake rule</span><select name="retakeRule"><option value="keep-both">Keep both scores</option><option value="replace">Replace original</option><option value="higher">Use higher score</option><option value="latest">Use latest score</option></select></label>
            </div>
            <div id="category-list" class="category-list">
              <article class="category-card">
                <div class="category-top"><label class="category-name"><span>Category name</span><input type="text" class="category-title" value="Homework" maxlength="40" /></label><label class="category-weight"><span>Course weight</span><span class="input-wrap"><input class="category-course-weight" type="number" min="0" max="100" step="any" value="30" /><b>%</b></span></label><button type="button" class="icon-button remove-category" aria-label="Remove Homework category">×</button></div>
                <div class="assignment-list"><div class="assignment-row"><input aria-label="Assignment name" class="assignment-name" type="text" value="Problem sets" maxlength="60" /><input aria-label="Assignment score" class="assignment-score" type="number" min="0" max="100" step="any" value="88" placeholder="Score %" /><input aria-label="Assignment relative weight" class="assignment-weight" type="number" min="0.01" step="any" value="1" placeholder="Weight" /><select aria-label="Assignment type" class="assignment-type"><option value="regular">Graded</option><option value="missing">Missing (0)</option><option value="makeup">Makeup</option><option value="retake">Retake</option><option value="extra">Extra credit</option></select><button class="icon-button remove-assignment" type="button" aria-label="Remove assignment">×</button></div><div class="assignment-row"><input aria-label="Assignment name" class="assignment-name" type="text" value="Reading work" maxlength="60" /><input aria-label="Assignment score" class="assignment-score" type="number" min="0" max="100" step="any" value="94" placeholder="Score %" /><input aria-label="Assignment relative weight" class="assignment-weight" type="number" min="0.01" step="any" value="1" placeholder="Weight" /><select aria-label="Assignment type" class="assignment-type"><option value="regular">Graded</option><option value="missing">Missing (0)</option><option value="makeup">Makeup</option><option value="retake">Retake</option><option value="extra">Extra credit</option></select><button class="icon-button remove-assignment" type="button" aria-label="Remove assignment">×</button></div></div>
                <button type="button" class="add-assignment">＋ Add assignment</button>
              </article>
              <article class="category-card">
                <div class="category-top"><label class="category-name"><span>Category name</span><input type="text" class="category-title" value="Quizzes" maxlength="40" /></label><label class="category-weight"><span>Course weight</span><span class="input-wrap"><input class="category-course-weight" type="number" min="0" max="100" step="any" value="20" /><b>%</b></span></label><button type="button" class="icon-button remove-category" aria-label="Remove Quizzes category">×</button></div>
                <div class="assignment-list"><div class="assignment-row"><input aria-label="Assignment name" class="assignment-name" type="text" value="Quiz average" maxlength="60" /><input aria-label="Assignment score" class="assignment-score" type="number" min="0" max="100" step="any" value="85" placeholder="Score %" /><input aria-label="Assignment relative weight" class="assignment-weight" type="number" min="0.01" step="any" value="1" placeholder="Weight" /><select aria-label="Assignment type" class="assignment-type"><option value="regular">Graded</option><option value="missing">Missing (0)</option><option value="makeup">Makeup</option><option value="retake">Retake</option><option value="extra">Extra credit</option></select><button class="icon-button remove-assignment" type="button" aria-label="Remove assignment">×</button></div></div>
                <button type="button" class="add-assignment">＋ Add assignment</button>
              </article>
              <article class="category-card">
                <div class="category-top"><label class="category-name"><span>Category name</span><input type="text" class="category-title" value="Tests &amp; projects" maxlength="40" /></label><label class="category-weight"><span>Course weight</span><span class="input-wrap"><input class="category-course-weight" type="number" min="0" max="100" step="any" value="20" /><b>%</b></span></label><button type="button" class="icon-button remove-category" aria-label="Remove Tests and projects category">×</button></div>
                <div class="assignment-list"><div class="assignment-row"><input aria-label="Assignment name" class="assignment-name" type="text" value="Midterm" maxlength="60" /><input aria-label="Assignment score" class="assignment-score" type="number" min="0" max="100" step="any" value="92" placeholder="Score %" /><input aria-label="Assignment relative weight" class="assignment-weight" type="number" min="0.01" step="any" value="1" placeholder="Weight" /><select aria-label="Assignment type" class="assignment-type"><option value="regular">Graded</option><option value="missing">Missing (0)</option><option value="makeup">Makeup</option><option value="retake">Retake</option><option value="extra">Extra credit</option></select><button class="icon-button remove-assignment" type="button" aria-label="Remove assignment">×</button></div></div>
                <button type="button" class="add-assignment">＋ Add assignment</button>
              </article>
            </div>
            <button type="button" class="add-row-button" id="add-category">＋ Add a category</button>
            <p class="field-hint" id="advanced-help">Weighted category shares plus final/remaining work must total 100%. Assignment weights are relative within a category. Blank work remains ungraded; missing work counts as zero. Extra credit adds percentage points to its category and is not weighted as an assignment. Makeup counts separately. To apply a retake rule, name it exactly like its original assignment.</p>
          </section>

          <div class="form-actions">
            <button type="submit" class="primary-button" id="calculate-button">Calculate What I Need on the Final <span aria-hidden="true">→</span></button>
            <p>Calculations happen on your device. Your grades stay private.</p>
          </div>
          <div class="error-message" id="form-error" role="alert" hidden></div>
        </form>

        <aside class="result-card" aria-labelledby="result-title" aria-live="polite">
          <div class="result-label"><span class="result-spark" aria-hidden="true">✦</span> YOUR RESULT <span class="live-badge"><i></i> LIVE</span></div>
          <div class="result-status" id="result-status" data-status="achievable">You’ve got this</div>
          <h3 id="result-title"><span id="result-number">68.4</span><span id="result-unit">%</span></h3>
          <p class="result-caption" id="result-caption">needed on your final to reach your target</p>
          <div class="result-divider"></div>
          <dl class="result-facts">
            <div><dt>Your current grade</dt><dd id="fact-current">92.4%</dd></div>
            <div><dt>Your target grade</dt><dd id="fact-target">90%</dd></div>
            <div><dt>Final exam weight</dt><dd id="fact-weight">10%</dd></div>
            <div><dt>Best possible course grade</dt><dd id="fact-maximum">93.2%</dd></div>
            <div id="advanced-earned-row" hidden><dt>Earned course contribution</dt><dd id="fact-earned">—</dd></div>
            <div id="advanced-completed-row" hidden><dt>Completed course weight</dt><dd id="fact-completed">—</dd></div>
            <div id="converted-grade-row" hidden><dt>Your institution’s scale</dt><dd id="converted-grade"></dd></div>
          </dl>
          <p class="calculation-note" id="calculation-note">Your current work contributes 83.16 points. You need 6.84 more points from the final.</p>
          <div class="result-actions">
            <button type="button" class="result-action" id="copy-result"><svg viewBox="0 0 20 20" aria-hidden="true"><rect x="7" y="7" width="9" height="10" rx="1.5"></rect><path d="M12 7V4.5A1.5 1.5 0 0 0 10.5 3h-6A1.5 1.5 0 0 0 3 4.5v7A1.5 1.5 0 0 0 4.5 13H7"></path></svg> Copy</button>
            <button type="button" class="result-action" id="share-result"><svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="15" cy="4" r="2"></circle><circle cx="5" cy="10" r="2"></circle><circle cx="15" cy="16" r="2"></circle><path d="m7 9 6-4M7 11l6 4"></path></svg> Share</button>
          </div>
        </aside>
      </div>

      <section class="insights" aria-label="Grade scenarios and visualization">
        <div class="insight-block">
          <div class="insight-heading"><div><span class="insight-kicker">PLAN AHEAD</span><h3>What if you score…</h3></div><p>Estimated overall course grade</p></div>
          <div class="table-wrap">
            <table class="scenario-table"><thead><tr><th>Final score</th><th>Course grade</th><th>Final score</th><th>Course grade</th><th>Final score</th><th>Course grade</th></tr></thead><tbody id="scenario-body"></tbody></table>
          </div>
        </div>
        <div class="chart-block">
          <div class="insight-heading"><div><span class="insight-kicker">SEE THE CURVE</span><h3>Your final, visualized</h3></div></div>
          <div class="chart-wrap"><svg id="grade-chart" viewBox="0 0 500 190" role="img" aria-labelledby="chart-title chart-desc"><title id="chart-title">Final exam score and course grade chart</title><desc id="chart-desc">A line chart calculated from your current grade and final exam weight.</desc><g id="chart-grid"></g><polyline id="chart-line" points="" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"></polyline><g id="chart-points"></g><g id="chart-labels"></g></svg></div>
          <div class="chart-legend"><span><i></i> Overall course grade</span><span>Final exam score →</span></div>
        </div>
      </section>
    </section>

    <section class="grading-settings" aria-labelledby="grading-title">
      <div class="settings-intro"><span class="eyebrow-dot"></span><span>OPTIONAL GRADE DISPLAY</span><h2 id="grading-title">Show your school’s grade.</h2><p>Calculations always use percentages. Add your school’s published cutoffs to optionally show the matching letter grade or GPA beside your result.</p></div>
      <div class="settings-card">
        <div class="settings-grid">
          <label class="field"><span>Grade display</span><select id="grade-display"><option value="percentage">Percentage only</option><option value="letter">Institution-defined letter grade</option><option value="gpa">Institution-defined GPA</option></select></label>
          <label class="field" id="gpa-scale-field" hidden><span>GPA scale maximum</span><select id="gpa-scale"><option value="4">4.0 scale</option><option value="5">5.0 scale</option><option value="10">10.0 scale</option><option value="custom">Custom scale</option></select></label>
          <label class="field" id="custom-gpa-field" hidden><span>Custom GPA maximum</span><span class="input-wrap"><input id="custom-gpa-max" type="number" min="0.1" max="100" step="any" value="4" /><b>max</b></span></label>
        </div>
        <div class="threshold-editor" id="threshold-editor" hidden>
          <div class="threshold-heading"><div><strong>Enter your school’s cutoffs</strong><span>Each row maps a course percentage to its grade</span></div><button type="button" class="add-row-button" id="add-threshold">＋ Add a cutoff</button></div>
          <p class="threshold-help" id="threshold-help">Each row is a rule: if your overall course percentage meets that minimum, show the grade. Add the cutoffs from your syllabus. These entries only label your result; the required exam score is still calculated as a percentage.</p>
          <div class="threshold-list" id="threshold-list" aria-live="polite"></div>
        </div>
        <p class="threshold-prompt" id="threshold-prompt">Choose “Institution-defined letter grade” or “Institution-defined GPA” above to add cutoffs. Percentage-only mode does not use a grading scale.</p>
      </div>
    </section>

    <section class="explain-section" id="how-it-works">
      <div class="section-eyebrow"><span class="eyebrow-dot"></span> NO MYSTERY MATH</div>
      <h2>How the final grade calculator works</h2>
      <p class="section-lead">Your final grade depends on two things: what you’ve already earned, and how much the remaining work counts.</p>
      <div class="explain-grid">
        <article class="explain-card formula-card">
          <span class="card-number">01 / THE FORMULA</span>
          <h3>Find your required final score</h3>
          <div class="formula"><span>Target − Current × (1 − Final weight)</span><i>÷</i><span>Final weight</span></div>
          <p>Enter grades and weights as percentages. The final exam weight is converted to a fraction before it’s used in the formula.</p>
        </article>
        <article class="explain-card example-card">
          <span class="card-number">02 / AN EXAMPLE</span>
          <h3>92.4% so far, aiming for 90%</h3>
          <p>If your final is worth 10%, your coursework contributes 92.4 × 0.90 = 83.16 points.</p>
          <p>You need 90 − 83.16 = 6.84 more course points. Divide by 0.10 and your required final score is <strong>68.4%</strong>.</p>
        </article>
        <article class="explain-card weights-card">
          <span class="card-number">03 / WEIGHTED GRADES</span>
          <h3>How a weighted grade calculator works</h3>
          <p>A weighted grade gives each assessment a share of the whole course grade. A final worth 20% can move your course grade more than one worth 5%.</p>
          <p>For the required-score mode, your current grade represents all coursework other than the final.</p>
        </article>
        <article class="explain-card gpa-card">
          <span class="card-number">04 / PERCENTAGE ≠ GPA</span>
          <h3>Keep grading systems distinct</h3>
          <p>A percentage is a score. A GPA or letter grade is assigned using a grading scale set by an institution. There is no single conversion that applies to every school.</p>
          <p>Enter your school’s published thresholds to optionally show a letter grade or GPA beside the percentage.</p>
        </article>
      </div>
    </section>

    <section class="faq-section" id="faq">
      <div class="section-eyebrow"><span class="eyebrow-dot"></span> GOOD TO KNOW</div>
      <h2>Frequently asked questions</h2>
      <div class="faq-list">
        {faq.map((item) => <details class="faq-item"><summary>{item.question}<span aria-hidden="true">＋</span></summary><p>{item.answer} {item.mode && <a href="#calculator" data-calculator-mode={item.mode}>{item.linkText}</a>}</p></details>)}
      </div>
    </section>

    <section class="recent-section" id="recent" aria-labelledby="recent-title" hidden>
      <div class="recent-heading"><div><div class="section-eyebrow"><span class="eyebrow-dot"></span> JUST FOR YOU</div><h2 id="recent-title">Recent calculations</h2></div><button class="text-button" type="button" id="clear-history">Clear history</button></div>
      <ul class="recent-list" id="recent-list"></ul>
    </section>
  </main>

  <footer class="site-footer">
    <a class="brand" href="/" aria-label="GradeWise home"><span class="brand-mark" aria-hidden="true">g</span><span class="brand-copy"><strong>GradeWise</strong></span></a>
    <p>Clear numbers. A calmer plan.</p>
    <a href="#calculator">Back to calculator ↑</a>
    <small>Check your syllabus for your institution’s grading rules. This calculator is a planning aid.</small>
  </footer>
  <div class="toast" id="toast" role="status" aria-live="polite"></div>
</Layout>

